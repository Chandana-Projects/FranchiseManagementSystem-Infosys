# Backend Environment Configuration Template
# Copy this file to .env and replace placeholders with real secrets
NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://user:password@localhost:5432/franchise_db?schema=public"

# Cryptographic JWT Secret (Generate a strong 256-bit key in production)
JWT_SECRET="replace-with-a-secure-random-jwt-secret-key"

# Python ML Microservice URL
ML_SERVICE_URL="http://127.0.0.1:8000"

# Allowed CORS Origins (Comma-separated for multi-domain setup)
ALLOWED_ORIGINS="http://localhost:3000"
