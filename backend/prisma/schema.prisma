generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model expenses {
  expense_id   Int       @id @default(autoincrement())
  outlet_id    Int
  expense_type String?   @db.VarChar(50)
  amount       Decimal?  @db.Decimal(12, 2)
  expense_date DateTime? @db.Date
  outlets      outlets   @relation(fields: [outlet_id], references: [outlet_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_expense_outlet")
}

model managers {
  manager_id       Int       @id @default(autoincrement())
  full_name        String    @db.VarChar(100)
  email            String    @unique @db.VarChar(100)
  phone            String?   @db.VarChar(15)
  experience_years Int?
  joining_date     DateTime? @db.Date
  status           String?   @default("Active") @db.VarChar(20)
  outlets          outlets[]
}

model monthly_targets {
  target_id              Int      @id @default(autoincrement())
  outlet_id              Int
  month                  String?  @db.VarChar(20)
  target_amount          Decimal? @db.Decimal(12, 2)
  achieved_amount        Decimal? @db.Decimal(12, 2)
  achievement_percentage Decimal? @db.Decimal(5, 2)
  outlets                outlets  @relation(fields: [outlet_id], references: [outlet_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_target_outlet")
}

model notifications {
  notification_id   Int       @id @default(autoincrement())
  outlet_id         Int?
  title             String?   @db.VarChar(150)
  message           String?
  notification_type String?   @db.VarChar(30)
  channel           String?   @db.VarChar(20)
  priority          String?   @default("low") @db.VarChar(10)
  is_read           Boolean?  @default(false)
  is_acknowledged   Boolean?  @default(false)
  acknowledged_at   DateTime? @db.Timestamp(6)
  recipient_role    String?   @db.VarChar(30)
  recipient_user_id Int?
  deep_link_url     String?   @db.VarChar(255)
  sla_minutes       Int?      @default(30)
  escalated         Boolean?  @default(false)
  escalated_at      DateTime? @db.Timestamp(6)
  resolved          Boolean?  @default(false)
  resolved_at       DateTime? @db.Timestamp(6)
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  outlets           outlets?  @relation(fields: [outlet_id], references: [outlet_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notification_outlet")
  recipient         users?    @relation("notification_recipient", fields: [recipient_user_id], references: [user_id], onDelete: SetNull, onUpdate: NoAction, map: "fk_notification_user")
  escalations       escalations[]
}

model outlet_health {
  health_id            Int       @id @default(autoincrement())
  outlet_id            Int
  inventory_score      Int?
  staff_score          Int?
  sales_score          Int?
  customer_score       Int?
  overall_health_score Int?
  updated_at           DateTime? @default(now()) @db.Timestamp(6)
  outlets              outlets   @relation(fields: [outlet_id], references: [outlet_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_health_outlet")
}

model outlet_ratings {
  rating_id     Int       @id @default(autoincrement())
  outlet_id     Int
  customer_name String?   @db.VarChar(100)
  rating        Decimal?  @db.Decimal(2, 1)
  feedback      String?
  review_date   DateTime? @db.Date
  outlets       outlets   @relation(fields: [outlet_id], references: [outlet_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_rating_outlet")
}

model outlets {
  outlet_id       Int               @id @default(autoincrement())
  outlet_name     String            @db.VarChar(100)
  franchise_name  String?           @db.VarChar(100)
  manager_id      Int?
  city            String?           @db.VarChar(50)
  state           String?           @db.VarChar(50)
  address         String?
  latitude        Decimal?          @db.Decimal(10, 7)
  longitude       Decimal?          @db.Decimal(10, 7)
  opening_date    DateTime?         @db.Date
  status          String?           @default("Active") @db.VarChar(20)
  expenses        expenses[]
  monthly_targets monthly_targets[]
  notifications   notifications[]
  outlet_health   outlet_health[]
  outlet_ratings  outlet_ratings[]
  managers        managers?         @relation(fields: [manager_id], references: [manager_id], onUpdate: NoAction, map: "fk_manager")
  performance     performance[]
  sales           sales[]
  users           users[]
  inventory_items inventory_items[]
  action_plans    action_plans[]
}

model performance {
  performance_id    Int      @id @default(autoincrement())
  outlet_id         Int
  month             String?  @db.VarChar(20)
  target_revenue    Decimal? @db.Decimal(12, 2)
  actual_revenue    Decimal? @db.Decimal(12, 2)
  growth_percentage Decimal? @db.Decimal(5, 2)
  performance_score Int?
  outlets           outlets  @relation(fields: [outlet_id], references: [outlet_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_performance_outlet")
}

model sales {
  sale_id   Int      @id @default(autoincrement())
  outlet_id Int
  sale_date DateTime @db.Date
  revenue   Decimal? @default(0) @db.Decimal(12, 2)
  orders    Int?     @default(0)
  customers Int?     @default(0)
  outlets   outlets  @relation(fields: [outlet_id], references: [outlet_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sales_outlet")
}

model users {
  user_id                Int       @id @default(autoincrement())
  full_name              String    @db.VarChar(100)
  email                  String    @unique @db.VarChar(100)
  password_hash          String    @db.VarChar(255)
  role                   String?   @default("manager") @db.VarChar(20)
  outlet_id              Int?
  created_at             DateTime? @default(now()) @db.Timestamp(6)
  outlets                outlets?  @relation(fields: [outlet_id], references: [outlet_id], onDelete: SetNull, onUpdate: NoAction, map: "fk_user_outlet")
  notifications_received notifications[] @relation("notification_recipient")
  plans_assigned         action_plans[]  @relation("plan_assignee")
  plans_created          action_plans[]  @relation("plan_creator")
}

model inventory_items {
  item_id    Int       @id @default(autoincrement())
  outlet_id  Int
  sku        String    @db.VarChar(30)
  name       String    @db.VarChar(150)
  category   String?   @db.VarChar(50)
  unit       String?   @db.VarChar(20)
  quantity   Decimal   @db.Decimal(12, 2) @default(0)
  reorder_at Decimal   @db.Decimal(12, 2) @default(0)
  supplier   String?   @db.VarChar(100)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  outlets    outlets   @relation(fields: [outlet_id], references: [outlet_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inventory_outlet")
}

model escalations {
  escalation_id     Int       @id @default(autoincrement())
  notification_id   Int
  escalated_to_role String?   @db.VarChar(30)
  escalated_to_user Int?
  reason            String?
  sent_at           DateTime? @default(now()) @db.Timestamp(6)
  acknowledged_at   DateTime? @db.Timestamp(6)
  notification      notifications @relation(fields: [notification_id], references: [notification_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_escalation_notification")
}

model action_plans {
  plan_id         Int       @id @default(autoincrement())
  notification_id Int?
  outlet_id       Int?
  title           String    @db.VarChar(200)
  description     String?
  priority        String?   @default("medium") @db.VarChar(10)
  status          String?   @default("open") @db.VarChar(20)
  assigned_to     Int?
  due_date        DateTime? @db.Date
  created_by      Int?
  evidence_url    String?   @db.VarChar(500)
  comments        String?
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  updated_at      DateTime? @default(now()) @db.Timestamp(6)
  resolved_at     DateTime? @db.Timestamp(6)
  outlets         outlets?  @relation(fields: [outlet_id], references: [outlet_id], onDelete: SetNull, onUpdate: NoAction, map: "fk_plan_outlet")
  assignee        users?    @relation("plan_assignee", fields: [assigned_to], references: [user_id], onDelete: SetNull, onUpdate: NoAction, map: "fk_plan_assignee")
  creator         users?    @relation("plan_creator", fields: [created_by], references: [user_id], onDelete: SetNull, onUpdate: NoAction, map: "fk_plan_creator")
}

model notification_rules {
  rule_id       Int      @id @default(autoincrement())
  event_type    String   @db.VarChar(50)
  priority      String   @db.VarChar(10)
  channels      String[]
  sla_minutes   Int      @default(30)
  auto_escalate Boolean  @default(true)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamp(6)
}
